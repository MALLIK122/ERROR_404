{
  "version": 2,
  "name": "error-404-landing",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/og-image.jpg", "destination": "/public/og-image.jpg" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
